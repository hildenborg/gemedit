{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
		{
			"type": "shell",
			"label": "Atari ST cross compile",
			"command": "make",
			"args": [
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "shell",
			"label": "Start Hatari debug",
			"command": "${workspaceFolder}/hatari_debug.sh",
			"args": [
				"--inferior", "gedit.prg",
				"--build", "${workspaceFolder}/build",
				"--harddrive", "${workspaceFolder}/sthd"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "Atari ST cross compile",
			"isBackground": true,
			"problemMatcher": {
				"owner": "hatari",
				"pattern": {
					"regexp": "^hatari_debug\\.sh: (.*)$",
					"message": 1
				},
				"background": {
					"activatesOnStart": true,
					"beginsPattern": "^TOS:",
					"endsPattern": "^GDB server: program .* started, waiting for gdb to connect"
				}
			}
		},
		{
			"type": "shell",
			"label": "Stop Hatari debug",
			"command": "${workspaceFolder}/hatari_debug.sh",
			"args": ["--stop"],
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent"
			}
		},
    ]
}
