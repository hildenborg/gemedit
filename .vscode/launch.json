    "version": "2.0.0",
    "configurations": [
        {
			"type": "gdbtarget",
			"request": "attach",
			"name": "cdt debug",
			"program": "${workspaceFolder}/build/gedit",
			"preLaunchTask": "Start Hatari debug",
			"postDebugTask": "Stop Hatari debug",
			"gdb": "gdb-multiarch",
			"cwd": "${workspaceRoot}",
			"target": {"host": "localhost","port": "1234"}
        }
    ]
}
